# PromiseBond standalone GenLayer Bradbury staging environment.
# Run `npm run setup:promisebond:env` to create the ignored local file.
PROMISEBOND_ENVIRONMENT=staging
PROMISEBOND_PORT=8790

# Browser-visible Bradbury wallet and native test GEN configuration.
VITE_PROMISEBOND_GENLAYER_RPC_URL=https://rpc-bradbury.genlayer.com
VITE_PROMISEBOND_WALLET_RPC_URL=https://rpc.testnet-chain.genlayer.com
VITE_PROMISEBOND_GENLAYER_CHAIN_ID=4221
VITE_PROMISEBOND_GENLAYER_NETWORK=bradbury
VITE_PROMISEBOND_GENLAYER_EXPLORER_URL=https://explorer-bradbury.genlayer.com
VITE_PROMISEBOND_GENLAYER_FAUCET_URL=https://testnet-faucet.genlayer.foundation
VITE_PROMISEBOND_NATIVE_ASSET_SYMBOL=GEN
VITE_PROMISEBOND_NATIVE_ASSET_DECIMALS=18
# Optional Reown project ID for WalletConnect mobile/QR wallets. Injected and Coinbase work without it.
VITE_PROMISEBOND_WALLETCONNECT_PROJECT_ID=

# Read-only server chain configuration. Wallets sign contract calls client-side.
PROMISEBOND_GENLAYER_RPC_URL=https://rpc-bradbury.genlayer.com
PROMISEBOND_GENLAYER_CHAIN_ID=4221
PROMISEBOND_GENLAYER_NETWORK=bradbury
PROMISEBOND_NATIVE_ASSET_SYMBOL=GEN
PROMISEBOND_NATIVE_ASSET_DECIMALS=18
PROMISEBOND_CONTRACT_RELEASE=PromiseBondNativeGenV1
# Independent-source quorum release; must match the exact deployed PromiseBond.py bytes.
PROMISEBOND_CONTRACT_SOURCE_HASH=0xea739a4cc74438ffebb4656fd2ebc39d2a1df2239a6a9722ac227009c0488ea1
PROMISEBOND_FINALITY_POLL_INTERVAL_MS=3000
PROMISEBOND_FINALITY_POLL_RETRIES=0

# Dedicated PromiseBond persistence. Never reuse BackIt's URI or database user.
PROMISEBOND_MONGODB_DB_NAME=promisebond_staging
PROMISEBOND_MONGODB_URI=

# PromiseBond API hardening and scheduled workers.
PROMISEBOND_TRUST_PROXY=false
PROMISEBOND_RATE_LIMIT_WINDOW_MS=60000
PROMISEBOND_RATE_LIMIT_MAX=120
PROMISEBOND_JSON_BODY_LIMIT=2kb
PROMISEBOND_CRON_SECRET=
# On Vercel, CRON_SECRET must equal PROMISEBOND_CRON_SECRET so platform cron
# requests carry the same bearer credential. It is not needed for local runs.
CRON_SECRET=
PROMISEBOND_RECONCILE_INTERVAL_MS=60000
PROMISEBOND_JOB_LEASE_MS=30000
PROMISEBOND_CHAIN_READ_TIMEOUT_MS=20000
PROMISEBOND_JOB_RETRY_BASE_MS=5000
PROMISEBOND_WORKER_BATCH_SIZE=50
PROMISEBOND_WORKER_MAX_RUNTIME_MS=240000
